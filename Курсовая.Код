// ======================== БАЗОВЫЙ КЛАСС «ТОВАР» ========================
class Product
{
protected:
    int id;                 // уникальный ID товара
    string name;            // наименование
    double price;           // цена за единицу
    int quantity;           // количество на складе
    static int nextId;      // статический счетчик для генерации ID

public:
    // Конструкторы
    Product() : id(++nextId), name(""), price(0.0), quantity(0) {}
    
    Product(const string& n, double p, int q)
        : id(++nextId), name(n), price(p), quantity(q)
    {
        if (price < 0) price = 0;
        if (quantity < 0) quantity = 0;
    }
    
    // Копирующий конструктор
    Product(const Product& other)
        : id(++nextId), name(other.name), price(other.price), quantity(other.quantity) {}
    
    // Виртуальный деструктор
    virtual ~Product()
    {
        cout << "Товар \"" << name << "\" (ID:" << id << ") удалён из системы." << endl;
    }
    
    // Геттеры
    int getId() const { return id; }
    string getName() const { return name; }
    double getPrice() const { return price; }
    int getQuantity() const { return quantity; }
    
    // Сеттеры с валидацией
    void setPrice(double p)
    {
        if (p >= 0)
            price = p;
        else
            cout << "Ошибка: цена не может быть отрицательной!" << endl;
    }
    
    void setQuantity(int q)
    {
        if (q >= 0)
            quantity = q;
        else
            cout << "Ошибка: количество не может быть отрицательным!" << endl;
    }
    
    void setName(const string& n) { name = n; }
    
    // Виртуальные методы (полиморфизм)
    virtual void sell(int amount)
    {
        if (amount <= 0)
        {
            cout << "Ошибка: количество для продажи должно быть положительным!" << endl;
            return;
        }
        if (amount > quantity)
        {
            cout << "Ошибка: недостаточно товара на складе! Доступно: " << quantity << endl;
            return;
        }
        quantity -= amount;
        cout << "✓ Продано " << amount << " ед. товара \"" << name << "\". Осталось: " << quantity << endl;
    }
    
    virtual void restock(int amount)
    {
        if (amount <= 0)
        {
            cout << "Ошибка: количество пополнения должно быть положительным!" << endl;
            return;
        }
        quantity += amount;
        cout << "✓ Поступление " << amount << " ед. товара \"" << name << "\". Теперь: " << quantity << endl;
    }
    
    virtual void printInfo() const
    {
        cout << "┌─────────────────────────────────────────────────" << endl;
        cout << "│ ID: " << id << " | " << name << endl;
        cout << "│ Цена: " << fixed << setprecision(2) << price << " руб." << endl;
        cout << "│ Кол-во: " << quantity << " шт." << endl;
        cout << "└─────────────────────────────────────────────────" << endl;
    }
    
    // Дружественный класс
    friend class Warehouse;
};

int Product::nextId = 0;

// ========== ВИРТУАЛЬНЫЙ БАЗОВЫЙ КЛАСС «СКОРОПОРТЯЩИЙСЯ» ==========
class Perishable
{
protected:
    time_t expirationDate;   // срок годности (в формате времени Unix)
    string expirationDateStr; // строковое представление для ввода/вывода
    
public:
    Perishable() : expirationDate(0), expirationDateStr("") {}
    
    Perishable(const string& expDateStr) : expirationDateStr(expDateStr)
    {
        setExpirationDateFromString(expDateStr);
    }
    
    virtual ~Perishable() {}
    
    void setExpirationDateFromString(const string& dateStr)
    {
        expirationDateStr = dateStr;
        // Простой парсинг даты в формате ДД.ММ.ГГГГ
        struct tm tm = {0};
        int day, month, year;
        char sep1, sep2;
        stringstream ss(dateStr);
        if (ss >> day >> sep1 >> month >> sep2 >> year)
        {
            if (sep1 == '.' && sep2 == '.')
            {
                tm.tm_mday = day;
                tm.tm_mon = month - 1;
                tm.tm_year = year - 1900;
                expirationDate = mktime(&tm);
            }
        }
    }
    
    time_t getExpirationDate() const { return expirationDate; }
    string getExpirationDateStr() const { return expirationDateStr; }
    
    // Проверка на просрочку
    bool isExpired() const
    {
        time_t now = time(nullptr);
        return (difftime(now, expirationDate) > 0);
    }
    
    // Уникальный метод
    virtual void checkFreshness() const
    {
        time_t now = time(nullptr);
        double daysLeft = difftime(expirationDate, now) / (60 * 60 * 24);
        if (expirationDate == 0 || daysLeft < 0)
            cout << "     [ПРОСРОЧЕН!]" << endl;
        else if (daysLeft < 3)
            cout << "     [Срок годности истекает через " << (int)daysLeft << " дня(ей)!]" << endl;
        else
            cout << "     [Свежий товар, осталось " << (int)daysLeft << " дней]" << endl;
    }
};

// ========== ВИРТУАЛЬНЫЙ БАЗОВЫЙ КЛАСС «УЦЕНЯЕМЫЙ» ==========
class Discountable
{
protected:
    double discountPercent;   // процент скидки
    
public:
    Discountable() : discountPercent(0.0) {}
    
    Discountable(double disc) : discountPercent(disc)
    {
        if (discountPercent < 0) discountPercent = 0;
        if (discountPercent > 90) discountPercent = 90;
    }
    
    virtual ~Discountable() {}
    
    void setDiscount(double disc)
    {
        if (disc >= 0 && disc <= 90)
            discountPercent = disc;
        else
            cout << "Ошибка: скидка должна быть от 0 до 90%" << endl;
    }
    
    double getDiscount() const { return discountPercent; }
    
    // Уникальный метод
    double getDiscountedPrice(double originalPrice) const
    {
        return originalPrice * (100.0 - discountPercent) / 100.0;
    }
    
    void applyDiscount(double disc)
    {
        setDiscount(disc);
        cout << "✓ Установлена скидка " << discountPercent << "%" << endl;
    }
};

// ========== КЛАСС «БАКАЛЕЯ» (МНОЖЕСТВЕННОЕ НАСЛЕДОВАНИЕ) ==========
class Groceries : public Product, public Perishable, public Discountable
{
private:
    string packageType;   // тип упаковки
    string category;      // категория товара (крупы, макароны и т.д.)
    
public:
    // Конструктор по умолчанию
    Groceries() : Product(), Perishable(), Discountable(), packageType(""), category("") {}
    
    // Конструктор с параметрами
    Groceries(const string& n, double p, int q, const string& expDate, double disc, 
              const string& pack, const string& cat)
        : Product(n, p, q), Perishable(expDate), Discountable(disc), 
          packageType(pack), category(cat) {}
    
    ~Groceries() override
    {
        cout << "Бакалейный товар \"" << getName() << "\" удалён." << endl;
    }
    
    // Переопределённые методы
    void sell(int amount) override
    {
        if (isExpired())
        {
            cout << "  Ошибка: товар \"" << getName() << "\" просрочен! Продажа невозможна." << endl;
            return;
        }
        Product::sell(amount);
    }
    
    void printInfo() const override
    {
        cout << "┌─────────────────────────────────────────────────" << endl;
        cout << "│ [БАКАЛЕЯ] ID:" << getId() << " | " << getName() << endl;
        cout << "│ Категория: " << category << " | Упаковка: " << packageType << endl;
        cout << "│ Цена: " << fixed << setprecision(2) << getPrice() << " руб.";
        if (discountPercent > 0)
            cout << " (со скидкой: " << getDiscountedPrice(getPrice()) << " руб.)";
        cout << endl;
        cout << "│ Кол-во: " << getQuantity() << " шт." << endl;
        cout << "│ Срок годности: " << expirationDateStr << endl;
        checkFreshness();
        cout << "└─────────────────────────────────────────────────" << endl;
    }
    
    // Уникальные методы
    void applySeasonalDiscount(double extraPercent)
    {
        if (extraPercent < 0 || extraPercent > 50)
        {
            cout << "Ошибка: сезонная скидка должна быть от 0 до 50%" << endl;
            return;
        }
        discountPercent += extraPercent;
        if (discountPercent > 90) discountPercent = 90;
        cout << "  Применена сезонная скидка! Общая скидка: " << discountPercent << "%" << endl;
    }
    
    void changePackageType(const string& newType)
    {
        packageType = newType;
        cout << "  Тип упаковки изменён на: " << packageType << endl;
    }
    
    // Геттеры для ввода
    static void inputGroceries(Groceries& g)
    {
        string name, expDate, pack, cat;
        double price, disc;
        int quantity;
        
        cin.ignore();
        cout << "Введите наименование товара: ";
        getline(cin, name);
        
        cout << "Введите цену: ";
        cin >> price;
        
        cout << "Введите количество: ";
        cin >> quantity;
        
        cout << "Введите срок годности (ДД.ММ.ГГГГ): ";
        cin >> expDate;
        
        cout << "Введите скидку (0-90): ";
        cin >> disc;
        
        cin.ignore();
        cout << "Введите тип упаковки: ";
        getline(cin, pack);
        
        cout << "Введите категорию (крупы, макароны, консервы и т.д.): ";
        getline(cin, cat);
        
        g = Groceries(name, price, quantity, expDate, disc, pack, cat);
    }
    
    friend class Warehouse;
};

// ========== КЛАСС «МОЛОЧНЫЙ ПРОДУКТ» (ОДИНОЧНОЕ НАСЛЕДОВАНИЕ ОТ PRODUCT И PERISHABLE) ==========
class DairyProduct : public Product, public Perishable
{
private:
    double fatContent;      // жирность
    string manufacturer;    // производитель
    static int nextId;
    
public:
    // Конструкторы
    DairyProduct() : Product(), Perishable(), fatContent(0.0), manufacturer("") {}
    
    DairyProduct(const string& n, double p, int q, const string& expDate, 
                 double fat, const string& manuf)
        : Product(n, p, q), Perishable(expDate), fatContent(fat), manufacturer(manuf)
    {
        if (fatContent < 0) fatContent = 0;
        if (fatContent > 50) fatContent = 50;
    }
    
    ~DairyProduct()
    {
        cout << "Молочный продукт \"" << getName() << "\" удалён." << endl;
    }
    
    // Геттеры
    double getFatContent() const { return fatContent; }
    string getManufacturer() const { return manufacturer; }
    
    // Уникальные методы
    void applyMarkdown(double percent)
    {
        if (percent < 0 || percent > 70)
        {
            cout << "Ошибка: уценка должна быть от 0 до 70%" << endl;
            return;
        }
        setPrice(getPrice() * (100.0 - percent) / 100.0);
        cout << "  Применена уценка " << percent << "%. Новая цена: " << fixed << setprecision(2) << getPrice() << " руб." << endl;
    }
    
    void changeManufacturer(const string& newManuf)
    {
        manufacturer = newManuf;
        cout << "  Производитель изменён на: " << manufacturer << endl;
    }
    
    void printInfo() const override
    {
        cout << "┌─────────────────────────────────────────────────" << endl;
        cout << "│ [МОЛОЧНЫЙ] ID:" << getId() << " | " << getName() << endl;
        cout << "│ Производитель: " << manufacturer << " | Жирность: " << fatContent << "%" << endl;
        cout << "│ Цена: " << fixed << setprecision(2) << getPrice() << " руб." << endl;
        cout << "│ Кол-во: " << getQuantity() << " шт." << endl;
        cout << "│ Срок годности: " << getExpirationDateStr() << endl;
        checkFreshness();
        cout << "└─────────────────────────────────────────────────" << endl;
    }
    
    void sell(int amount) override
    {
        if (amount <= 0)
        {
            cout << "Ошибка: количество для продажи должно быть положительным!" << endl;
            return;
        }
        if (isExpired())
        {
            cout << "  Ошибка: молочный продукт \"" << getName() << "\" просрочен!" << endl;
            return;
        }
        if (amount > getQuantity())
        {
            cout << "Ошибка: недостаточно товара! Доступно: " << getQuantity() << endl;
            return;
        }
        setQuantity(getQuantity() - amount);
        cout << "  Продано " << amount << " ед. молочного продукта \"" << getName() << "\". Осталось: " << getQuantity() << endl;
    }
    
    void restock(int amount) override
    {
        if (amount <= 0)
        {
            cout << "Ошибка: количество пополнения должно быть положительным!" << endl;
            return;
        }
        setQuantity(getQuantity() + amount);
        cout << "  Поступление " << amount << " ед. \"" << getName() << "\". Теперь: " << getQuantity() << endl;
    }


    
    // Статический метод для ввода
    static void inputDairyProduct(DairyProduct& d)
    {
        string name, expDate, manuf;
        double price, fat;
        int quantity;
        
        cin.ignore();
        cout << "Введите наименование товара: ";
        getline(cin, name);
        
        cout << "Введите цену: ";
        cin >> price;
        
        cout << "Введите количество: ";
        cin >> quantity;
        
        cout << "Введите срок годности (ДД.ММ.ГГГГ): ";
        cin >> expDate;
        
        cout << "Введите жирность (%): ";
        cin >> fat;
        
        cin.ignore();
        cout << "Введите производителя: ";
        getline(cin, manuf);
        
        d = DairyProduct(name, price, quantity, expDate, fat, manuf);
    }
    
    friend class Warehouse;
};

