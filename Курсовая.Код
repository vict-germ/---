// ======================== КЛАСС «СКЛАД» ========================
class Warehouse
{
private:
    vector<Product*> products;
    vector<Groceries*> groceriesList;
    vector<DairyProduct*> dairyList;
    
public:
    Warehouse() {}
    
    ~Warehouse()
    {
        for (auto p : products)
            delete p;
        products.clear();
        groceriesList.clear();
        dairyList.clear();
    }
    
    // Добавление готового товара (для начальной загрузки)
    void addProduct(Product* p)
    {
        products.push_back(p);
        
        // Если это бакалейный товар, добавим в отдельный список
        Groceries* g = dynamic_cast<Groceries*>(p);
        if (g) groceriesList.push_back(g);
        
        // Если это молочный продукт, добавим в отдельный список
        DairyProduct* d = dynamic_cast<DairyProduct*>(p);
        if (d) dairyList.push_back(d);
        
        cout << "  Товар \"" << p->getName() << "\" добавлен на склад." << endl;
    }
    
    // Добавление бакалейного товара через ввод с клавиатуры
    void addGroceries()
    {
        Groceries* g = new Groceries();
        Groceries::inputGroceries(*g);
        products.push_back(g);
        groceriesList.push_back(g);
        cout << "\n  Бакалейный товар успешно добавлен! ID: " << g->getId() << endl;
    }
    
    void addDairyProduct()
    {
        DairyProduct* d = new DairyProduct();
        DairyProduct::inputDairyProduct(*d);
        products.push_back(d);
        dairyList.push_back(d);
        cout << "\n  Молочный продукт успешно добавлен! ID: " << d->getId() << endl;
    }
    
    // Поиск по ID
    Product* findById(int id)
    {
        for (auto p : products)
        {
            if (p->getId() == id)
                return p;
        }
        return nullptr;
    }
    
    // Поиск по имени
    Product* findByName(const string& name)
    {
        for (auto p : products)
        {
            if (p->getName() == name)
                return p;
        }
        return nullptr;
    }
    
    // Продажа товара
    void sellProduct()
    {
        int id, amount;
        cout << "Введите ID товара: ";
        cin >> id;
        
        Product* p = findById(id);
        if (!p)
        {
            cout << "  Товар с ID " << id << " не найден!" << endl;
            return;
        }
        
        cout << "Введите количество для продажи: ";
        cin >> amount;
        p->sell(amount);
    }
    
    // Пополнение склада
    void restockProduct()
    {
        int id, amount;
        cout << "Введите ID товара: ";
        cin >> id;
        
        Product* p = findById(id);
        if (!p)
        {
            cout << "  Товар с ID " << id << " не найден!" << endl;
            return;
        }
        
        cout << "Введите количество для пополнения: ";
        cin >> amount;
        p->restock(amount);
    }
    
    // Вывод всех товаров
    void printAllProducts() const
    {
        if (products.empty())
        {
            cout << "\n  Склад пуст." << endl;
            return;
        }
        
        cout << "\n═══════════════════════════════════════════════════" << endl;
        cout << "            ВСЕ ТОВАРЫ НА СКЛАДЕ" << endl;
        cout << "═══════════════════════════════════════════════════" << endl;
        for (const auto& p : products)
        {
            p->printInfo();
            cout << endl;
        }
    }
    
    // Вывод бакалейных товаров
    void printGroceries() const
    {
        if (groceriesList.empty())
        {
            cout << "\n  Бакалейные товары отсутствуют." << endl;
            return;
        }
        
        cout << "\n═══════════════════════════════════════════════════" << endl;
        cout << "            БАКАЛЕЙНЫЕ ТОВАРЫ" << endl;
        cout << "═══════════════════════════════════════════════════" << endl;
        for (const auto& g : groceriesList)
        {
            g->printInfo();
            cout << endl;
        }
    }
    
    // Вывод молочных продуктов
    void printDairyProducts() const
    {
        if (dairyList.empty())
        {
            cout << "\n  Молочные продукты отсутствуют." << endl;
            return;
        }
        
        cout << "\n═══════════════════════════════════════════════════" << endl;
        cout << "            МОЛОЧНЫЕ ПРОДУКТЫ" << endl;
        cout << "═══════════════════════════════════════════════════" << endl;
        for (const auto& d : dairyList)
        {
            d->printInfo();
            cout << endl;
        }
    }
    
    // Применить скидку к бакалейному товару
    void applyDiscountToGroceries()
    {
        int id;
        double disc;
        cout << "Введите ID бакалейного товара: ";
        cin >> id;
        
        for (auto g : groceriesList)
        {
            if (g->getId() == id)
            {
                cout << "Введите размер скидки (0-90): ";
                cin >> disc;
                g->applyDiscount(disc);
                return;
            }
        }
        cout << "  Бакалейный товар с ID " << id << " не найден!" << endl;
    }
    
    // Применить сезонную скидку
    void applySeasonalDiscount()
    {
        int id;
        double extra;
        cout << "Введите ID бакалейного товара: ";
        cin >> id;
        
        for (auto g : groceriesList)
        {
            if (g->getId() == id)
            {
                cout << "Введите дополнительную скидку (0-50): ";
                cin >> extra;
                g->applySeasonalDiscount(extra);
                return;
            }
        }
        cout << "  Бакалейный товар с ID " << id << " не найден!" << endl;
    }
    
    // Применить уценку к молочному продукту
    void applyMarkdownToDairy()
    {
        int id;
        double percent;
        cout << "Введите ID молочного продукта: ";
        cin >> id;
        
        for (auto d : dairyList)
        {
            if (d->getId() == id)
            {
                cout << "Введите процент уценки (0-70): ";
                cin >> percent;
                d->applyMarkdown(percent);
                return;
            }
        }
        cout << "  Молочный продукт с ID " << id << " не найден!" << endl;
    }
    
    // Списание просроченных товаров
    void removeExpired()
    {
        cout << "\n═══════════════════════════════════════════════════" << endl;
        cout << "         ПРОВЕРКА ПРОСРОЧЕННЫХ ТОВАРОВ" << endl;
        cout << "═══════════════════════════════════════════════════" << endl;
        
        int removed = 0;
        auto it = products.begin();
        while (it != products.end())
        {
            Perishable* perish = dynamic_cast<Perishable*>(*it);
            if (perish && perish->isExpired())
            {
                cout << "  Списание просроченного товара: " << (*it)->getName() << endl;
                delete *it;
                it = products.erase(it);
                removed++;
            }
            else
            {
                ++it;
            }
        }
        
        // Обновляем списки
        groceriesList.clear();
        dairyList.clear();
        for (auto p : products)
        {
            Groceries* g = dynamic_cast<Groceries*>(p);
            if (g) groceriesList.push_back(g);
            
            DairyProduct* d = dynamic_cast<DairyProduct*>(p);
            if (d) dairyList.push_back(d);
        }
        
        if (removed > 0)
            cout << "\n  Списано " << removed << " просроченных товаров." << endl;
        else
            cout << "  Просроченных товаров не найдено." << endl;
    }
    
    // Изменить цену товара
    void changePrice()
    {
        int id;
        double newPrice;
        cout << "Введите ID товара: ";
        cin >> id;
        
        Product* p = findById(id);
        if (!p)
        {
            cout << "  Товар с ID " << id << " не найден!" << endl;
            return;
        }
        
        cout << "Введите новую цену: ";
        cin >> newPrice;
        p->setPrice(newPrice);
        cout << "  Цена изменена!" << endl;
    }
    
    // Изменить количество товара
    void changeQuantity()
    {
        int id, newQuantity;
        cout << "Введите ID товара: ";
        cin >> id;
        
        Product* p = findById(id);
        if (!p)
        {
            cout << "  Товар с ID " << id << " не найден!" << endl;
            return;
        }
        
        cout << "Введите новое количество: ";
        cin >> newQuantity;
        p->setQuantity(newQuantity);
        cout << "  Количество изменено!" << endl;
    }
    
    // Выявление расхождений между учетными данными и фактическими (ИНВЕНТАРИЗАЦИЯ)
    void checkDiscrepancy()
    {
        cout << "\n═══════════════════════════════════════════════════" << endl;
        cout << "         ИНВЕНТАРИЗАЦИЯ: ВЫЯВЛЕНИЕ РАСХОЖДЕНИЙ" << endl;
        cout << "═══════════════════════════════════════════════════" << endl;
        
        if (products.empty())
        {
            cout << "  На складе нет товаров для инвентаризации." << endl;
            return;
        }
        
        int actualQuantity;
        char confirm;
        
        for (auto p : products)
        {
            cout << "\nТовар: " << p->getName() << " (ID:" << p->getId() << ")" << endl;
            cout << "  Учетное количество: " << p->getQuantity() << " шт." << endl;
            cout << "  Введите фактическое количество при пересчете: ";
            cin >> actualQuantity;
            
            if (actualQuantity != p->getQuantity())
            {
                cout << "    РАСХОЖДЕНИЕ: " << abs(actualQuantity - p->getQuantity()) 
                     << " шт. (" << (actualQuantity > p->getQuantity() ? "излишек" : "недостача") << ")" << endl;
                cout << "  Корректировать учет? (y/n): ";
                cin >> confirm;
                if (confirm == 'y' || confirm == 'Y')
                {
                    p->setQuantity(actualQuantity);
                    cout << "    Учет скорректирован!" << endl;
                }
                else
                {
                    cout << "    Учет не скорректирован." << endl;
                }
            }
            else
            {
                cout << "    Расхождений нет." << endl;
            }
        }
        cout << "\n✓ Инвентаризация завершена!" << endl;
    }
};

